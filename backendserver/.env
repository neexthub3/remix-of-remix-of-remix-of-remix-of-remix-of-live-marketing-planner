# Backend server's own settings (XAMPP MySQL). Empty values are ignored and config.php is used instead.
LIFEOS_MASTER_KEY="10"
LIFEOS_DB_HOST="127.0.0.1"
LIFEOS_DB_PORT="3306"
LIFEOS_DB_NAME="lifeos"
LIFEOS_DB_USER="root"
# Leave empty to keep the live server's existing database password; XAMPP default is empty.
LIFEOS_DB_PASS=""
# Leave empty to keep the live app secret (changing it logs everyone out).
LIFEOS_APP_SECRET=""
